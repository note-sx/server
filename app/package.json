{
  "name": "notesx-api",
  "version": "1.4.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "lint": "eslint src",
    "deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 execute notesx-db --remote --file=schema.sql",
    "test": "podman build --build-arg PACKAGE_VERSION=$(npm pkg get version | xargs) --format docker -t notesx-test .. && podman run --init -it -p=3000:3000 --env-file .env notesx-test"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "hono": "^4.12.23",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "eslint": "^9.39.4",
    "neostandard": "^0.13.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
